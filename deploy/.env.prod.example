# PersonaCR production environment — TEMPLATE.
# On the server:  cp deploy/.env.prod.example deploy/.env.prod && nano deploy/.env.prod
# deploy/.env.prod is gitignored; never commit it. chmod 600 it.
#
# Read twice by docker compose:
#   --env-file deploy/.env.prod  → ${VARS} in docker-compose.prod.yml (DOMAIN, frontend build args)
#   env_file: .env.prod          → runtime env of backend + worker
# REDIS_URL, CHROMADB_URL, MAX_EMBED_TOKENS=1024, model cache paths and
# ALLOWED_ORIGINS are set in docker-compose.prod.yml — don't set them here.

# ── Site ─────────────────────────────────────────────────────────────────────
DOMAIN=personacr.northcentralus.cloudapp.azure.com

# ── Supabase (Dashboard → Project Settings → API) ────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public anon key — baked into the frontend bundle at build time (it is public by design).
SUPABASE_ANON_KEY=
# Secret — backend only. Bypasses RLS; never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still signs tokens with the legacy HS256 secret
# (Project Settings → JWT Keys → Legacy JWT Secret). Leave empty for ES256/JWKS.
SUPABASE_JWT_SECRET=

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
# Haiku 4.5 for the public demo (cost control). ~$0.01 per review at list price.
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# Only with LLM_PROVIDER=groq
GROQ_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Strongly recommended: without it every visitor shares GitHub's unauthenticated
# limit (60 requests/hour for this VM's IP). A fine-grained token with
# "Public repositories (read-only)" access is enough.
GITHUB_TOKEN=

# ── Abuse protection (backend/src/core/rate_limit.py) ────────────────────────
RATE_LIMIT_ENABLED=1
# Per user, sliding 1-hour window
RATE_LIMIT_REVIEWS_PER_HOUR=5
RATE_LIMIT_CHATS_PER_HOUR=30
RATE_LIMIT_ANALYZES_PER_HOUR=5
# All users together, sliding 24-hour window (0 = no cap). Bounds spend even if
# someone creates many anonymous guest sessions.
RATE_LIMIT_REVIEWS_PER_DAY=300
RATE_LIMIT_CHATS_PER_DAY=1000
RATE_LIMIT_ANALYZES_PER_DAY=100
# Comma-separated Supabase user ids (auth.users.id) that are never limited — e.g. yours.
RATE_LIMIT_EXEMPT_USERS=

# ── Jobs ─────────────────────────────────────────────────────────────────────
# A running job whose heartbeat is older than this reads as failed (worker died).
JOB_STALE_SECONDS=120
