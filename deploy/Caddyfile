# PersonaCR — Caddy in front of the compose stack (deploy/docker-compose.prod.yml).
# {$DOMAIN} comes from deploy/.env.prod. Caddy gets and renews the Let's Encrypt
# certificate by itself (needs ports 80 and 443 open in the Azure NSG and ufw),
# and redirects http:// to https://.

{$DOMAIN} {
	encode zstd gzip

	# Prometheus export stays internal (frontend nginx would otherwise proxy it).
	@internal path /metrics /metrics/*
	respond @internal 404

	# API, health, MCP, OpenAPI docs → FastAPI
	@backend path /api/* /health /mcp /mcp/* /docs /docs/* /openapi.json
	handle @backend {
		reverse_proxy backend:8000 {
			# MCP streams (SSE) — pass bytes through as they arrive
			flush_interval -1
		}
	}

	# Everything else → the SPA (nginx serves index.html for client routes)
	handle {
		reverse_proxy frontend:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
