SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY is not read by the backend — it is a frontend build arg
# (VITE_SUPABASE_ANON_KEY in frontend/.env or docker build --build-arg).
GROQ_API_KEY=
# Optional — GitHub token for private repo ingestion / higher API rate limits
GITHUB_TOKEN=
# Local Redis for async review jobs (docker compose up redis)
REDIS_URL=redis://localhost:6379/0
# Prometheus metrics export (GET /metrics); set 0 to disable recording
PERSONACR_METRICS_ENABLED=1
